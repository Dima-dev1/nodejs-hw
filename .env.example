PORT=9999
NODE_ENV=development
MONGO_URL = mongodb-connection

# Values are taken from your Brevo account
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# The email address used to register the brevo.com account
SMTP_FROM=

# Any string used to generate the token signature
JWT_SECRET=

# Frontend domain that the link in the email will point to
# For example: http://localhost:3001
FRONTEND_DOMAIN=
